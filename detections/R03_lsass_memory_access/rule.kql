// R03: a non-system process opens lsass.exe with memory-read access (Sysmon event 10).
// Uses the community Sysmon parser function, which exposes EventData fields as columns.
Sysmon
| where EventID == 10 and TargetImage endswith @"\lsass.exe"
| where binary_and(tolong(GrantedAccess), 0x10) != 0
| extend Process = tolower(tostring(split(SourceImage, @"\")[-1]))
| where not(Process in ("csrss.exe", "wininit.exe", "services.exe", "lsass.exe", "lsm.exe",
                        "svchost.exe", "wmiprvse.exe")
            and SourceImage matches regex @"(?i)^c:\\windows\\system32\\(wbem\\)?[^\\]+$")
| where not(Process == "msmpeng.exe"
            and SourceImage matches regex @"(?i)^c:\\(programdata\\microsoft|program files)\\windows defender\\")
| project TimeGenerated, Computer, SourceUser, SourceImage, GrantedAccess
